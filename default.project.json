    "Workspace": {
      "$properties": {
        "Gravity": 35.0238,
        "FallenPartsDestroyHeight": -2000,
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 13.5,
        "Technology": "Future",
        "GlobalShadows": true,
        "ShadowSoftness": 0.12,
        "EnvironmentDiffuseScale": 1.0,
        "EnvironmentSpecularScale": 1.0
      }
    },
    "MaterialService": {
      "$properties": {
        "Use2022Materials": true
      }
    }
  }
