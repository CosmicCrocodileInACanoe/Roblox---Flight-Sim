{
  "name": "OpenSkiesFlightSim",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 4.0,
        "EnableMouseLockOption": false
      },
